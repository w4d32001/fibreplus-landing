<script is:inline>
    const navbar = document.getElementById("navbar");
    const menuBackdrop = document.getElementById("menu-backdrop");
    const menuList = document.getElementById("menu-list");
    const menuListMobile = document.getElementById("menu-list-mobile");
    const mobileMenuOverlay = document.getElementById("mobile-menu-overlay");
    const menuItems = document.querySelectorAll("#menu-list .menu-item");
    const menuItemsMobile = document.querySelectorAll(
        "#menu-list-mobile .menu-item-mobile",
    );
    const menuToggle = document.getElementById("menu-toggle");
    const burgerLine1 = document.getElementById("burger-line-1");
    const burgerLine2 = document.getElementById("burger-line-2");
    const burgerLine3 = document.getElementById("burger-line-3");
    const logoText = document.getElementById("logo-text");

    let isMenuOpen = false;
    let lastScrollY = window.scrollY;
    let ticking = false;

    function toggleMobileMenu() {
        isMenuOpen = !isMenuOpen;

        if (isMenuOpen) {
            menuListMobile.classList.remove(
                "opacity-0",
                "invisible",
                "translate-y-[-20px]",
            );
            menuListMobile.classList.add(
                "opacity-100",
                "visible",
                "translate-y-0",
            );
            mobileMenuOverlay.classList.remove("opacity-0", "invisible");
            mobileMenuOverlay.classList.add("opacity-100", "visible");
            document.body.style.overflow = "hidden";

            burgerLine1.style.transform = "rotate(45deg) translateY(0px)";
            burgerLine2.style.opacity = "0";
            burgerLine3.style.transform = "rotate(-45deg) translateY(0px)";
        } else {
            menuListMobile.classList.remove(
                "opacity-100",
                "visible",
                "translate-y-0",
            );
            menuListMobile.classList.add(
                "opacity-0",
                "invisible",
                "translate-y-[-20px]",
            );
            mobileMenuOverlay.classList.remove("opacity-100", "visible");
            mobileMenuOverlay.classList.add("opacity-0", "invisible");
            document.body.style.overflow = "";

            burgerLine1.style.transform = "";
            burgerLine2.style.opacity = "";
            burgerLine3.style.transform = "";
        }
    }

    menuToggle.addEventListener("click", toggleMobileMenu);
    mobileMenuOverlay.addEventListener("click", toggleMobileMenu);

    menuItemsMobile.forEach((item) => {
        item.addEventListener("click", () => {
            if (isMenuOpen) {
                toggleMobileMenu();
            }
        });
    });

    function moveBackdrop(el) {
        const itemRect = el.getBoundingClientRect();
        const listRect = menuList.getBoundingClientRect();
        const left = itemRect.left - listRect.left;
        const top = itemRect.top - listRect.top;

        menuBackdrop.style.left = `${left - 4}px`;
        menuBackdrop.style.top = `${top - 4}px`;
        menuBackdrop.style.width = `${itemRect.width + 8}px`;
        menuBackdrop.style.height = `${itemRect.height + 8}px`;
        menuBackdrop.style.opacity = "1";
    }

    menuItems.forEach((item) => {
        item.addEventListener("mouseenter", () => moveBackdrop(item));
    });

    menuList.addEventListener("mouseleave", () => {
        menuBackdrop.style.opacity = "0";
    });

    function handleScroll() {
        const currentScrollY = window.scrollY;

        if (currentScrollY > 50) {
            navbar.classList.add(
                "bg-white/95",
                "backdrop-blur-lg",
                "shadow-lg",
            );
            navbar.classList.remove("bg-transparent");

            menuItems.forEach((item) => {
                item.classList.remove("text-white");
                item.classList.add("text-gray-800");
            });

            menuToggle.classList.remove("text-white");
            menuToggle.classList.add("text-gray-800");

            if (logoText) {
                logoText.classList.remove("text-white");
                logoText.classList.add("text-gray-900");
            }
        } else {
            navbar.classList.remove(
                "bg-white/95",
                "backdrop-blur-lg",
                "shadow-lg",
            );
            navbar.classList.add("bg-transparent");

            menuItems.forEach((item) => {
                item.classList.remove("text-gray-800");
                item.classList.add("text-white");
            });

            menuToggle.classList.remove("text-gray-800");
            menuToggle.classList.add("text-white");

            if (logoText) {
                logoText.classList.remove("text-gray-900");
                logoText.classList.add("text-white");
            }
        }

        lastScrollY = currentScrollY;
        ticking = false;
    }

    function requestTick() {
        if (!ticking) {
            window.requestAnimationFrame(handleScroll);
            ticking = true;
        }
    }

    window.addEventListener("scroll", requestTick);

    function updateActiveLink() {
        const sections = document.querySelectorAll("section[id]");
        const scrollY = window.scrollY;

        sections.forEach((section) => {
            const sectionHeight = section.offsetHeight;
            const sectionTop = section.offsetTop - 100;
            const sectionId = section.getAttribute("id");
            const correspondingLink = document.querySelector(
                `#menu-list a[href="#${sectionId}"]`,
            );
            const correspondingLinkMobile = document.querySelector(
                `#menu-list-mobile a[href="#${sectionId}"]`,
            );

            if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
                menuItems.forEach((item) => {
                    item.classList.remove("text-blue-600", "font-bold");
                });
                menuItemsMobile.forEach((item) => {
                    item.classList.remove(
                        "bg-linear-to-r",
                        "from-blue-50",
                        "to-purple-50",
                    );
                    item.querySelector("svg")?.classList.remove(
                        "text-blue-600",
                    );
                });

                if (correspondingLink) {
                    correspondingLink.classList.add(
                        "text-blue-600",
                        "font-bold",
                    );
                }
                if (correspondingLinkMobile) {
                    correspondingLinkMobile.classList.add(
                        "bg-linear-to-r",
                        "from-blue-50",
                        "to-purple-50",
                    );
                    correspondingLinkMobile
                        .querySelector("svg")
                        ?.classList.add("text-blue-600");
                }
            }
        });
    }

    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener("click", function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute("href"));
            if (target) {
                const offsetTop = target.offsetTop - 80;
                window.scrollTo({
                    top: offsetTop,
                    behavior: "smooth",
                });
            }
        });
    });

    window.addEventListener("scroll", updateActiveLink);

    handleScroll();
    updateActiveLink();
</script>

