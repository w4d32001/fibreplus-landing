                                <rect x="88" y="38" width="4" height="7" fill="white"></rect>
                                <ellipse cx="90" cy="35" rx="8" ry="4" stroke="white" stroke-width="2" fill="none"></ellipse>
                                <ellipse cx="90" cy="32" rx="12" ry="6" stroke="white" stroke-width="2" fill="none"></ellipse>
                                <circle cx="90" cy="80" r="15" stroke="white" stroke-width="3" fill="none"></circle>
                                <ellipse cx="90" cy="80" rx="6" ry="15" stroke="white" stroke-width="2" fill="none"></ellipse>
                                <line x1="75" y1="80" x2="105" y2="80" stroke="white" stroke-width="2"></line>
                                <circle cx="47" cy="47" r="3" fill="white"></circle>
                                <circle cx="90" cy="52" r="3" fill="white"></circle>
                                <path d="M50 47 Q70 35, 87 50" stroke="white" stroke-width="2" stroke-dasharray="2,2" fill="none"></path>
