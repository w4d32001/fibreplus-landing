                                    <line x1="0" y1="3" x2="0" y2="9" stroke="white" stroke-width="2"></line>
                                </g>
                            </svg>
                        </div>
                        <span class="text-2xl text-white font-bold block text-center">
                            100% Fibra óptica
                        </span>
                        <span class="text-xs text-white block text-center">
                            Experimenta una conexión sin límites con <br /> el verdadero internet fibra óptica.
                        </span>
                    </div>

                    <div class="flex flex-col gap-y-4 items-center">
                        <div class="w-40 h-40 flex items-center justify-center">
                            <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
