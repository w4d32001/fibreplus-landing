---
import PlanCard from "../ui/PlanCard.astro";
---

<section id="servicios" class="min-h-svh pt-16 space-y-8">
    <div class="flex flex-col gap-y-4 justify-center">
        <h2 class="text-center text-xl md:text-4xl text-secondary font-semibold uppercase">
            Internet fibra óptica para tu hogar
        </h2>
        <span class="text-xs text-gray-500 text-center">
            Nuestros planes y promociones
        </span>
    </div>

    <div class="mx-auto bg-secondary">
        <div class="relative py-12 overflow-hidden">
            <div class=" mx-auto px-4">
                <div class="relative">
                    <button 
                        id="prevBtn" 
                        class="absolute left-0 top-1/2 -translate-y-1/2 z-10 bg-white/90 hover:bg-white text-secondary p-3 md:p-4 rounded-full shadow-2xl transition-all duration-300 hover:scale-110 backdrop-blur-sm"
                        aria-label="Plan anterior">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                    </button>

                    <button 
                        id="nextBtn" 
                        class="absolute right-0 top-1/2 -translate-y-1/2 z-10 bg-white/90 hover:bg-white text-secondary p-3 md:p-4 rounded-full shadow-2xl transition-all duration-300 hover:scale-110 backdrop-blur-sm"
                        aria-label="Plan siguiente">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </button>

                    <div class="overflow-hidden mx-12 md:mx-16">
                        <div id="carouselTrack" class="flex transition-transform duration-500 ease-out gap-4 md:gap-6 lg:gap-8 items-end">
