                                    speedFrom="100"
                                    internetPrice="55"
                                    tvPrice="95"
                                    regularPrice="120"
                                    hasFiberOptic={true}
                                    hasUnlimitedDevices={true}
                                    hasLimitedSpeed={false}
                                    installationFree={true}
                                />
                            </div>

                            <div class="carousel-item shrink-0">
                                <PlanCard
                                    speedFrom="200"
                                    internetPrice="60"
                                    tvPrice="100"
                                    regularPrice="120"
                                    hasFiberOptic={true}
                                    hasUnlimitedDevices={true}
                                    hasLimitedSpeed={false}
                                    installationFree={true}
                                    recommended
                                />
                            </div>

                            <div class="carousel-item shrink-0">
                                <PlanCard
                                    speedFrom="300"
                                    internetPrice="80"
                                    tvPrice="120"
                                    regularPrice="120"
                                    hasFiberOptic={true}
                                    hasUnlimitedDevices={true}
                                    hasLimitedSpeed={false}
                                    installationFree={true}
                                />
                            </div>

                            <div class="carousel-item shrink-0">
                                <PlanCard
                                    speedFrom="400"
                                    internetPrice="100"
                                    tvPrice="140"
                                    regularPrice="120"
                                    hasFiberOptic={true}
                                    hasUnlimitedDevices={true}
                                    hasLimitedSpeed={false}
                                    installationFree={true}
                                />
                            </div>

                            <div class="carousel-item shrink-0">
                                <PlanCard
                                    speedFrom="500"
                                    internetPrice="120"
                                    tvPrice="160"
                                    regularPrice="120"
                                    hasFiberOptic={true}
                                    hasUnlimitedDevices={true}
                                    hasLimitedSpeed={false}
                                    installationFree={true}
                                />
                            </div>
                        </div>
                    </div>

                    <div id="indicators" class="flex justify-center gap-2 mt-8">
                    </div>
                </div>
            </div>
        </div>

        <!-- Información adicional y beneficios -->
        <div class="mt-8 pb-8">
            <div>
                <div class="flex flex-col gap-y-4 items-center text-white mb-4 px-4 md:px-0">
                    <span class="md:text-2xl block text-center">
                        *Alquiler mensual del equipo Mesh: S/1 si migras desde otro operador, o S/5 para nuevos clientes.
                    </span>
                    <span class="text-xs md:text-md">
                        Beneficios de nuestro Internet Fibra Óptica
